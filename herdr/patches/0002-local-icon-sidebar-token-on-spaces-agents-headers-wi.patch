+/// Draws a `+` at the right end of a sidebar section header and returns its
+/// hit area, padded a cell to each side so it is easy to click.
+pub(in crate::client::shell) fn render_header_add(
+    buffer: &mut Buffer,
+    area: Rect,
+    y: u16,
+    palette: &Palette,
+) -> Rect {
+    let x = area.right().saturating_sub(2);
+    put_text(
+        buffer,
+        x,
+        y,
+        1,
+        "+",
+        Style::default()
+            .fg(palette.overlay1)
+            .add_modifier(Modifier::BOLD),
+    );
+    Rect::new(x.saturating_sub(1), y, 3.min(area.right() - x + 1), 1)
+}
+
 /// Resting fill of a space row in the expanded sidebar; glides ease between these.
 pub(in crate::client::shell) fn workspace_row_fill(
     palette: &Palette,
@@ -238,6 +260,9 @@ pub(crate) fn render_sidebar(
             .fg(palette.overlay0)
             .add_modifier(Modifier::BOLD),
     );
+    if config.mouse_capture && workspace_area.width >= 12 && workspace_area.height > 0 {
+        hits.spaces_add = render_header_add(buffer, workspace_area, workspace_area.y, palette);
+    }
 
