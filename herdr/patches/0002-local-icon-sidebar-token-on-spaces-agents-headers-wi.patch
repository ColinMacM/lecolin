+    #[test]
+    fn parses_icon_tokens_and_rejects_text_or_empty_icons() {
+        let config: crate::config::Config = toml::from_str(
+            r##"
+[ui.sidebar.spaces]
+rows = [[{ token = "icon:\uF07B", fg = "#007aff" }, "workspace"]]
+
+[ui.sidebar.agents]
+rows = [["icon:◆", "agent"]]
+"##,
+        )
+        .unwrap();
+        let (token, style) = config.ui.sidebar.spaces.rows[0][0].parts();
+        assert_eq!(token, &SpaceSidebarToken::Icon("\u{f07b}".into()));
+        assert!(style.fg.is_some());
+        assert_eq!(
+            config.ui.sidebar.agents.rows[0][0],
+            AgentSidebarToken::Icon("◆".into())
+        );
+
+        for invalid in ["icon:", "icon:abc", "icon:\u{7}"] {
+            let source = format!("[ui.sidebar.spaces]\nrows = [[{invalid:?}]]\n");
+            assert!(
+                toml::from_str::<crate::config::Config>(&source).is_err(),
+                "{invalid:?} should be rejected"
+            );
+        }
+        let ruled = r##"
+[ui.sidebar.spaces]
+rows = [[{ token = "icon:", rules = [{ equals = "x", hide = true }] }]]
