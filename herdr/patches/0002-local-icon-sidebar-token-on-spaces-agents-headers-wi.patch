-fn parse_sidebar_token<T>(value: String, builtins: &[(&str, T)]) -> Result<T, String>
+/// Prefix of the fixed-glyph token, e.g. `icon:` for a folder.
+const ICON_TOKEN_PREFIX: &str = "icon:";
+/// Widest glyph an icon token may hold, in terminal cells.
+const ICON_TOKEN_MAX_WIDTH: usize = 2;
+
+fn parse_sidebar_token<T>(
+    value: String,
+    builtins: &[(&str, T)],
+    icon: fn(String) -> T,
+) -> Result<T, String>
 where
     T: Clone + From<String>,
 {
     if let Some((_, token)) = builtins.iter().find(|(name, _)| *name == value) {
         return Ok(token.clone());
     }
+    if let Some(glyph) = value.strip_prefix(ICON_TOKEN_PREFIX) {
+        let width = unicode_width::UnicodeWidthStr::width(glyph);
+        if glyph.chars().any(char::is_control) || width == 0 || width > ICON_TOKEN_MAX_WIDTH {
+            return Err(format!(
+                "invalid sidebar icon `{value}`; use one glyph up to {ICON_TOKEN_MAX_WIDTH} cells wide"
+            ));
+        }
+        return Ok(icon(glyph.to_string()));
+    }
     let Some(name) = value.strip_prefix('$') else {
         return Err(format!(
             "unknown sidebar token `{value}`; custom tokens must start with `$`"
@@ -279,6 +302,7 @@ fn agent_token_name(token: &AgentSidebarToken) -> String {
