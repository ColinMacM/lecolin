diff --git a/src/client/shell/motion.rs b/src/client/shell/motion.rs
new file mode 100644
index 00000000..51677daf
--- /dev/null
+++ b/src/client/shell/motion.rs
@@ -0,0 +1,290 @@
+//! Color glides for client chrome: the active tab and the active space row ease
+//! between fills instead of switching in one frame.
+//!
+//! Each tracked color is a critically damped spring (damping ratio 1, no
+//! overshoot) per RGB channel. Retargeting keeps the color and velocity that
+//! are on screen, so a glide interrupted by another focus change bends toward
+//! the new fill without a jump. Colors that are not RGB (terminal palette
+//! entries, `reset`) switch at once.
+
+use std::collections::HashMap;
+use std::hash::{Hash, Hasher};
+use std::time::{Duration, Instant};
+
+use ratatui::style::Color;
+
+/// Time for a glide to cover most of its distance (Apple's spring "response").
+const RESPONSE: Duration = Duration::from_millis(220);
+/// Frame spacing while anything moves.
+pub(super) const FRAME_INTERVAL: Duration = Duration::from_millis(16);
+/// A glide has landed once every channel is this close to its target (0..=255 units).
+const SETTLE_DISTANCE: f32 = 0.5;
+/// ... and moving slower than this (units per second).
+const SETTLE_SPEED: f32 = 4.0;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) enum MotionTarget {
+    TabFill,
+    TabText,
+    WorkspaceFill,
+}
+
+/// A tracked color: what it belongs to plus a hash of that element's id, so
+/// looking one up never allocates.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub(super) struct MotionKey {
+    target: MotionTarget,
+    id: u64,
+}
+
+impl MotionKey {
+    pub(super) fn new(target: MotionTarget, id: &str) -> Self {
+        let mut hasher = std::collections::hash_map::DefaultHasher::new();
+        id.hash(&mut hasher);
+        Self {
+            target,
+            id: hasher.finish(),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Spring {
+    origin: Instant,
+    /// Displacement from the target at `origin`, per channel.
+    offset: [f32; 3],
+    /// Velocity at `origin`, per channel, in units per second.
+    velocity: [f32; 3],
+}
+
+impl Spring {
+    fn omega() -> f32 {
+        std::f32::consts::TAU / RESPONSE.as_secs_f32()
+    }
+
+    /// Critically damped: x(t) = (x0 + (v0 + w*x0) t) e^(-w t).
+    fn state(&self, now: Instant) -> ([f32; 3], [f32; 3]) {
+        let w = Self::omega();
+        let t = now.saturating_duration_since(self.origin).as_secs_f32();
+        let decay = (-w * t).exp();
+        let mut offset = [0.0; 3];
+        let mut velocity = [0.0; 3];
+        for c in 0..3 {
+            let a = self.offset[c];
+            let b = self.velocity[c] + w * a;
+            offset[c] = (a + b * t) * decay;
+            velocity[c] = (b - w * (a + b * t)) * decay;
+        }
+        (offset, velocity)
+    }
+
+    fn settled(&self, now: Instant) -> bool {
+        let (offset, velocity) = self.state(now);
+        offset.iter().all(|x| x.abs() < SETTLE_DISTANCE)
+            && velocity.iter().all(|v| v.abs() < SETTLE_SPEED)
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Track {
+    target: Color,
+    spring: Option<Spring>,
+    seen: u64,
+}
+
+impl Track {
+    fn presented(&self, now: Instant) -> Color {
+        let (Some(spring), Some(target)) = (self.spring, rgb(self.target)) else {
+            return self.target;
+        };
+        let (offset, _) = spring.state(now);
+        let channel = |c: usize| (target[c] + offset[c]).round().clamp(0.0, 255.0) as u8;
+        Color::Rgb(channel(0), channel(1), channel(2))
+    }
+}
+
+fn rgb(color: Color) -> Option<[f32; 3]> {
+    match color {
+        Color::Rgb(r, g, b) => Some([f32::from(r), f32::from(g), f32::from(b)]),
+        _ => None,
+    }
+}
+
+#[derive(Debug, Default)]
+pub(crate) struct ChromeMotion {
+    tracks: HashMap<MotionKey, Track>,
+    generation: u64,
+}
+
+impl ChromeMotion {
+    /// Starts a pass over the chrome; tracks not aimed again before `end_pass`
+    /// belong to elements that are gone and are dropped.
+    pub(super) fn begin_pass(&mut self) {
+        self.generation = self.generation.wrapping_add(1);
+    }
+
+    pub(super) fn end_pass(&mut self) {
+        let generation = self.generation;
+        self.tracks.retain(|_, track| track.seen == generation);
+    }
+
+    /// Points `key` at `target`. The first sighting of an element shows its
+    /// color at once; a changed target glides from the color on screen now,
+    /// keeping the current velocity.
+    pub(super) fn aim(&mut self, key: MotionKey, target: Color, now: Instant, animate: bool) {
+        let generation = self.generation;
+        let Some(track) = self.tracks.get_mut(&key) else {
+            self.tracks.insert(
+                key,
+                Track {
+                    target,
+                    spring: None,
+                    seen: generation,
+                },
+            );
+            return;
+        };
+        track.seen = generation;
+        if track.target == target {
+            return;
+        }
+        let presented = rgb(track.presented(now));
+        let velocity = track
+            .spring
+            .map(|spring| spring.state(now).1)
+            .unwrap_or([0.0; 3]);
+        track.target = target;
+        track.spring = match (animate, presented, rgb(target)) {
+            (true, Some(from), Some(to)) => Some(Spring {
+                origin: now,
+                offset: [from[0] - to[0], from[1] - to[1], from[2] - to[2]],
+                velocity,
+            }),
+            _ => None,
+        };
+    }
+
+    /// The color to draw for `key` now, or `fallback` for an untracked element.
+    pub(super) fn color(&self, key: MotionKey, fallback: Color, now: Instant) -> Color {
+        self.tracks
+            .get(&key)
+            .map_or(fallback, |track| track.presented(now))
+    }
+
+    pub(super) fn is_moving(&self) -> bool {
+        self.tracks.values().any(|track| track.spring.is_some())
+    }
+
+    /// Lands settled glides. True while anything was moving, so the frame that
+    /// lands the last glide is drawn too.
+    pub(super) fn tick(&mut self, now: Instant) -> bool {
+        let mut moving = false;
+        for track in self.tracks.values_mut() {
+            if let Some(spring) = track.spring {
+                moving = true;
+                if spring.settled(now) {
+                    track.spring = None;
+                }
+            }
+        }
+        moving
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const GREY: Color = Color::Rgb(240, 240, 243);
+    const BLUE: Color = Color::Rgb(36, 108, 244);
+
+    fn key() -> MotionKey {
+        MotionKey::new(MotionTarget::TabFill, "tab-1")
+    }
+
+    fn aimed(motion: &mut ChromeMotion, target: Color, now: Instant, animate: bool) {
+        motion.begin_pass();
+        motion.aim(key(), target, now, animate);
+        motion.end_pass();
+    }
+
+    #[test]
+    fn first_sighting_shows_target_without_motion() {
+        let mut motion = ChromeMotion::default();
+        let now = Instant::now();
+        aimed(&mut motion, BLUE, now, true);
+        assert_eq!(motion.color(key(), GREY, now), BLUE);
+        assert!(!motion.is_moving());
+    }
+
+    #[test]
+    fn retarget_glides_monotonically_without_overshoot_and_lands() {
+        let mut motion = ChromeMotion::default();
+        let start = Instant::now();
+        aimed(&mut motion, GREY, start, true);
+        aimed(&mut motion, BLUE, start, true);
+        assert_eq!(motion.color(key(), GREY, start), GREY);
+
+        let mut previous_red = 240;
+        for ms in (0..=400).step_by(8) {
+            let Color::Rgb(red, _, _) =
+                motion.color(key(), GREY, start + Duration::from_millis(ms))
+            else {
+                panic!("rgb glide");
+            };
+            assert!(
+                red <= previous_red,
+                "red rose at {ms} ms: {previous_red} -> {red}"
+            );
+            assert!(red >= 36, "overshot past the target at {ms} ms");
+            previous_red = red;
+        }
+        let landed = start + Duration::from_millis(400);
+        assert_eq!(motion.color(key(), GREY, landed), BLUE);
+        assert!(motion.tick(landed), "the landing frame is still drawn");
+        assert!(!motion.is_moving());
+        assert!(!motion.tick(landed), "nothing left to draw once landed");
+    }
+
+    #[test]
+    fn interrupting_a_glide_starts_from_the_color_on_screen() {
+        let mut motion = ChromeMotion::default();
+        let start = Instant::now();
+        aimed(&mut motion, GREY, start, true);
+        aimed(&mut motion, BLUE, start, true);
+        let midway = start + Duration::from_millis(60);
+        let on_screen = motion.color(key(), GREY, midway);
+        assert_ne!(on_screen, GREY);
+        assert_ne!(on_screen, BLUE);
+
+        aimed(&mut motion, GREY, midway, true);
+        assert_eq!(
+            motion.color(key(), GREY, midway),
+            on_screen,
+            "reversing must not jump"
+        );
+    }
+
+    #[test]
+    fn disabled_or_non_rgb_targets_switch_at_once() {
+        let mut motion = ChromeMotion::default();
+        let now = Instant::now();
+        aimed(&mut motion, GREY, now, false);
+        aimed(&mut motion, BLUE, now, false);
+        assert_eq!(motion.color(key(), GREY, now), BLUE);
+
+        aimed(&mut motion, Color::Reset, now, true);
+        assert_eq!(motion.color(key(), GREY, now), Color::Reset);
+        assert!(!motion.is_moving());
+    }
+
+    #[test]
+    fn elements_not_aimed_in_a_pass_are_forgotten() {
+        let mut motion = ChromeMotion::default();
+        let now = Instant::now();
+        aimed(&mut motion, BLUE, now, true);
+        motion.begin_pass();
+        motion.end_pass();
+        assert_eq!(motion.color(key(), GREY, now), GREY);
+    }
+}
