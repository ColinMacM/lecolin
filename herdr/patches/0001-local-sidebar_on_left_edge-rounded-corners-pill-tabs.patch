+#[test]
+fn focus_pane_left_at_left_edge_enters_navigate_mode_only_when_enabled() {
+    use crate::api::schema::{
+        Method, PaneDirection, PaneFocusDirectionReason, PaneFocusDirectionResult, PaneLayoutRect,
+        PaneLayoutSnapshot, ResponseResult,
+    };
+
+    let focus_result = |changed: bool| ResponseResult::PaneFocusDirection {
+        focus: PaneFocusDirectionResult {
+            changed,
+            reason: (!changed).then_some(PaneFocusDirectionReason::NoNeighbor),
+            source_pane_id: "pane_1".into(),
+            focused_pane_id: Some("pane_1".into()),
+            layout: PaneLayoutSnapshot {
+                workspace_id: "ws_1".into(),
+                tab_id: "tab_1".into(),
+                zoomed: false,
+                area: PaneLayoutRect {
+                    x: 0,
+                    y: 0,
+                    width: 80,
+                    height: 24,
+                },
+                focused_pane_id: "pane_1".into(),
+                panes: Vec::new(),
+                splits: Vec::new(),
+            },
+        },
+    };
+
+    // (enabled, key, direction, expect navigate)
+    for (enabled, key, direction, expect_navigate) in [
+        (true, b'h', PaneDirection::Left, true),
+        (false, b'h', PaneDirection::Left, false),
+        (true, b'l', PaneDirection::Right, false),
+        (true, b'k', PaneDirection::Up, false),
+    ] {
+        let mut state = local_navigation_state(false);
+        state.config.sidebar_on_left_edge = enabled;
+        preview_key(&mut state, &[0x02]);
+        let outcome = state.handle_input_bytes(&[key]);
+        let [ClientShellAction::Endpoint { request, .. }] = outcome.actions.as_slice() else {
+            panic!("expected a directional pane focus request");
+        };
+        let Method::PaneFocusDirection(params) = &request.method else {
+            panic!("expected PaneFocusDirection");
+        };
+        assert_eq!(params.direction, direction);
+        assert_eq!(state.mode, ClientShellMode::Terminal);
+
+        let (repaint, actions) =
+            state.handle_endpoint_result("boot-1", &request.id, Ok(focus_result(false)));
+        assert!(actions.is_empty());
+        assert_eq!(repaint, expect_navigate, "enabled={enabled} key={key}");
+        let expected_mode = if expect_navigate {
+            ClientShellMode::Navigate
+        } else {
+            ClientShellMode::Terminal
+        };
+        assert_eq!(state.mode, expected_mode, "enabled={enabled} key={key}");
+        if expect_navigate {
+            assert_eq!(
+                state.navigate_workspace_id,
+                state.navigation_target(&ClientEndpointId::Local, "ws_1")
+            );
+        }
+    }
+
+    // A neighbor that took focus never opens the sidebar.
+    let mut state = local_navigation_state(false);
+    state.config.sidebar_on_left_edge = true;
+    preview_key(&mut state, &[0x02]);
+    let outcome = state.handle_input_bytes(b"h");
+    let [ClientShellAction::Endpoint { request, .. }] = outcome.actions.as_slice() else {
+        panic!("expected a directional pane focus request");
+    };
+    state.handle_endpoint_result("boot-1", &request.id, Ok(focus_result(true)));
+    assert_eq!(state.mode, ClientShellMode::Terminal);
+}
