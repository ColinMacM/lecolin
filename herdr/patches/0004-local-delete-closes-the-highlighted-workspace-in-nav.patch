+#[test]
+fn navigation_delete_closes_highlighted_workspace_with_existing_confirmation() {
+    for (confirm_close, cancel) in [(false, false), (true, false), (true, true)] {
+        for remote_active in [false, true] {
+            let (mut state, remote) = navigation_state(workspaces(2));
+
+            if remote_active {
+                assert!(state.activate_endpoint_projection(&remote));
+            }
+
+            let endpoint = state.active_endpoint_id.clone();
+            state.config.confirm_close = confirm_close;
+            state.compose(100, 28).unwrap();
+            enter_navigation(&mut state);
+            preview_key(&mut state, b"\x1b[B");
+            assert_selected(&state, &endpoint, "ws_2");
+            assert_eq!(
+                state
+                    .snapshot
+                    .as_deref()
+                    .unwrap()
+                    .focused_workspace_id
+                    .as_deref(),
+                Some("ws_1")
+            );
+            let mut close = state.handle_input_bytes(b"\x1b[3~");
+
+            if confirm_close {
+                assert!(close.actions.is_empty());
+                assert!(matches!(
+                    state.overlay.as_ref(),
+                    Some(ClientShellOverlay::ConfirmClose(confirm))
+                        if confirm.workspace_id == "ws_2" && !confirm.close_group
+                ));
+                state.compose(100, 28).unwrap();
+                close = state.handle_input_bytes(if cancel { b"\x1b" } else { b"\r" });
+
+                if cancel {
+                    assert!(close.actions.is_empty());
+                    assert!(state.overlay.is_none());
+                    continue;
+                }
+            }
+
+            assert!(matches!(
+                close.actions.as_slice(),
+                [ClientShellAction::Endpoint { endpoint_id, request, .. }]
+                    if endpoint_id == &endpoint
+                        && matches!(&request.method, crate::api::schema::Method::WorkspaceClose(params)
+                            if params.workspace_id == "ws_2" && !params.close_group)
+            ));
+        }
+    }
+}
