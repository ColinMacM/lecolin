+    #[test]
+    fn pane_borders_follow_muted_and_accent_until_overridden() {
+        let base = Palette::catppuccin();
+        assert_eq!(base.pane_border(), base.overlay0);
+        assert_eq!(base.pane_border_focused(), base.accent);
+
+        let custom = crate::config::CustomThemeColors {
+            pane_border: Some("#d8dce3".to_string()),
+            pane_border_focused: Some("#9ec5ff".to_string()),
+            ..Default::default()
+        };
+        let palette = base.clone().with_overrides(&custom);
+        assert_eq!(palette.pane_border(), Color::Rgb(0xd8, 0xdc, 0xe3));
+        assert_eq!(palette.pane_border_focused(), Color::Rgb(0x9e, 0xc5, 0xff));
+        assert_eq!(
+            palette.overlay0, base.overlay0,
+            "muted text keeps its color"
+        );
+        assert_eq!(palette.accent, base.accent, "the accent keeps its color");
+    }
